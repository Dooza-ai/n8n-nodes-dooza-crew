{
	"name": "n8n-nodes-dooza-crew",
	"version": "0.1.0",
	"description": "n8n node for Dooza Crew: give tasks to your AI employees and get their results",
	"license": "MIT",
	"homepage": "https://dooza.ai",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"dooza",
		"ai agents",
		"ai employees"
	],
	"author": {
		"name": "Dooza",
		"email": "support@dooza.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Dooza-ai/n8n-nodes-dooza-crew.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DoozaCrewApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DoozaCrew/DoozaCrew.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
